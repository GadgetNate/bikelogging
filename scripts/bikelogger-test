#!/usr/bin/env python3
import os, sys, subprocess, json, sqlite3, time, glob
from pathlib import Path

def run(cmd, timeout=10):
    try:
        p=subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
        return {'cmd':' '.join(cmd),'rc':p.returncode,'out':p.stdout.strip(),'err':p.stderr.strip()}
    except Exception as e:
        return {'cmd':' '.join(cmd),'error':str(e)}

def check_import(name):
    try: __import__(name); return True
    except Exception as e: return str(e)

report={}
report['time']=run(['date','-Is'])
report['model']=run(['bash','-lc','tr -d "\0" </proc/device-tree/model 2>/dev/null || true'])
report['mem']=run(['bash','-lc','free -h'])
report['throttled']=run(['bash','-lc','vcgencmd get_throttled 2>/dev/null || true'])
report['temp']=run(['bash','-lc','vcgencmd measure_temp 2>/dev/null || true'])
report['service']=run(['systemctl','--no-pager','status','bikelogger.service'], timeout=5)
report['enabled']=run(['systemctl','is-enabled','bikelogger.service'])
report['active']=run(['systemctl','is-active','bikelogger.service'])
report['ports']=run(['bash','-lc','ss -lntp | grep -E ":8080|python|bikelogger" || true'])
report['http_status']=run(['bash','-lc','curl -s http://127.0.0.1:8080/status.json | head -c 4000'], timeout=8)
report['python_imports']={m:check_import(m) for m in ['flask','serial','gpiozero','smbus','picamera2']}
report['camera_list']=run(['bash','-lc','libcamera-hello --list-cameras 2>&1 | head -80'], timeout=10)
report['i2c_detect']=run(['bash','-lc','i2cdetect -y 1 2>/dev/null || true'])
report['imu_addresses']=run(['bash','-lc','i2cdetect -y 1 2>/dev/null | grep -E "1e|19|6a|6b" || true'])
report['ups_address']=run(['bash','-lc','i2cdetect -y 1 2>/dev/null | grep -E "42" || true'])
report['serial_devices']=run(['bash','-lc','ls -l /dev/serial* /dev/ttyAMA* /dev/ttyS* 2>/dev/null || true'])
report['gps_sample']=run(['bash','-lc','timeout 5 cat /dev/serial0 2>/dev/null | head -5 || true'], timeout=8)
report['wifi_ifaces']=run(['bash','-lc','iw dev 2>/dev/null || ip link show'])
report['bluetooth_status']=run(['bash','-lc','rfkill list bluetooth 2>/dev/null; hciconfig -a 2>/dev/null || true; bluetoothctl show 2>/dev/null || true'], timeout=8)
report['bluetooth_sample']=run(['bash','-lc','rfkill unblock bluetooth 2>/dev/null || true; btmgmt --index 0 power on 2>/dev/null || true; timeout 12 stdbuf -oL -eL btmgmt --index 0 find 2>&1 | head -80 || true'], timeout=18)
report['disk']=run(['bash','-lc','df -h / /var/lib/bikelogger 2>/dev/null'])
report['rides']=run(['bash','-lc','find /var/lib/bikelogger/rides -maxdepth 2 -type f | tail -40 || true'])
report['recent_logs']=run(['bash','-lc','journalctl -u bikelogger.service -n 120 --no-pager'], timeout=8)
text=json.dumps(report, indent=2)
Path('/tmp/bikelogger_test_report.json').write_text(text)
print(text)
print('\nSaved: /tmp/bikelogger_test_report.json')
